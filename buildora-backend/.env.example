PORT=5000

# MongoDB Atlas: Atlas > Connect > Drivers. Add the database name before the "?":
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/buildora?retryWrites=true&w=majority
# (Local alternative: mongodb://127.0.0.1:27017/buildora)
MONGO_URI=

# ---- Meta WhatsApp (ONE Buildora Meta app for all businesses) - backend only ----
# Meta App > Settings > Basic
META_APP_ID=
# Meta App > Settings > Basic > App secret. Required for Embedded Signup and webhook signature checks.
META_APP_SECRET=
# Meta App > Facebook Login for Business > Configurations > your WhatsApp Embedded Signup configuration ID
EMBEDDED_SIGNUP_CONFIG_ID=
META_API_VERSION=v23.0
# Any random string you choose; the same value is entered in Meta's webhook settings.
META_VERIFY_TOKEN=
# Encrypts each business's WhatsApp token in MongoDB. Generate once and keep it safe
# (losing it means every business must reconnect):  openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Optional, legacy/dev only: token + IDs for businesses connected before Embedded Signup.
# New connections never use these.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=

# ---- Deployment (optional) ----
# Public URL of this backend, shown as the webhook URL in the dashboard.
PUBLIC_BACKEND_URL=
# Comma-separated frontend origins allowed by CORS, e.g. https://buildora.vercel.app (empty = allow all, dev only)
CORS_ORIGINS=
