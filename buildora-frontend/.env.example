# Public URL of the Buildora backend (no trailing slash, no /api).
# Leave empty in development: requests go to /api and Vite proxies them.
# Production (Vercel): https://your-buildora-backend.onrender.com
VITE_API_URL=

# Development only: where the Vite dev server proxies /api
VITE_DEV_API_PROXY=http://localhost:5000
VITE_DEV_PORT=5174

# NOTE: never put Meta tokens or database URLs here. Everything prefixed with VITE_ is public.
